# Copia este fichero a .env o, mejor, deja que ./deploy.sh lo genere.

# Puerto del host donde se publica la app (frontend + API + WebSocket).
# deploy.sh busca uno libre si el que hay aqui esta ocupado.
PORT=3000

# Contrasena que hay que teclear para crear una partida.
ROLEPLAY_PASSWORD="MeGustaElRol"

# Token del tunel de Cloudflare. Si esta puesto, deploy.sh arranca ademas el
# contenedor cloudflared y publica la app sin abrir puertos en el router.
# CLOUDFLARE_TUNNEL_TOKEN="eyJhIjoi..."
